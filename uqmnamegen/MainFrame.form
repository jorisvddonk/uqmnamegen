      <SubComponents>
        <Component class="javax.swing.JTextArea" name="textarea_stuff">
          <Properties>
            <Property name="columns" type="int" value="20"/>
            <Property name="editable" type="boolean" value="false"/>
            <Property name="lineWrap" type="boolean" value="true"/>
            <Property name="rows" type="int" value="5"/>
            <Property name="text" type="java.lang.String" value="-Character between brackets ([]) can be used.&#xa;-Character can be UPPERCASED to result in an UPPERCASED version of whatever character is generated form that list (unless the character belongs to a SPECIAL LIST, see below).&#xa;-Character lists are currently hardcoded; perhaps in the future this will change.&#xa;-A # can be inserted anywhere in patterns.txt to serve as comment. Anything after the # will not be used.&#xa;----------------------------&#xa;&#xa;Special lists:&#xa;[u] - Random number (0-9 incl.)&#xa;[U] - Random nonzero number (1-9 incl.)&#xa;[p] - Previous character; lowercase.&#xa;[\] - Raw. Character generated will ALWAYS be the character after this character.&#xa;&#xa;&#xa;&#xa;&#xa;"/>
            <Property name="wrapStyleWord" type="boolean" value="true"/>
          </Properties>
        </Component>
      </SubComponents>
    </Container>
